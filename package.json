{
  "name": "xiaoge-static-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "astro check && astro build && pagefind --site dist --glob \"archives/**/index.html\"",
    "build:worker": "node scripts/build-worker.mjs",
    "preview": "astro preview",
    "deploy": "wrangler deploy",
    "cf:preview": "npm run build:worker && wrangler dev"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/rss": "^4.0.12",
    "@astrojs/sitemap": "^3.3.1",
    "@vercel/analytics": "^2.0.1",
    "astro": "^5.15.5",
    "playwright": "^1.62.1",
    "smol-toml": "^1.6.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "pagefind": "^1.5.2",
    "sharp": "^0.35.3",
    "wrangler": "^4.100.0"
  }
}
